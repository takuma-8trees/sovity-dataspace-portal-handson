# Dataspace Portal local demo (ports are bound to 127.0.0.1)

# Browser access URLs
PORTAL_URL=http://portal.local:28080
KEYCLOAK_PUBLIC_URL=http://auth.local:28081

# URL-encoded base for redirect_uri
# "http://portal.local:28080" => "http%3A%2F%2Fportal.local%3A28080"
PORTAL_URL_ENCODED=http%3A%2F%2Fportal.local%3A28080

# Secrets (generate your own)
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
PORTAL_DB_PASSWORD=change-me

# Portal backend secrets
PORTAL_ADMIN_CLIENT_SECRET=change-me
PORTAL_CONFIG_API_KEY=change-me

# oauth2-proxy
PORTAL_OAUTH2_CLIENT_SECRET=change-me
# 16/24/32 bytes base64 recommended; oauth2-proxy expects 16/24/32 bytes.
PORTAL_COOKIE_SECRET=change-me

